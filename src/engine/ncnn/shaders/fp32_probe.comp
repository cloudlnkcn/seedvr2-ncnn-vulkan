#version 450
// Runtime inputs prevent constant folding. The host supplies exact binary
// products whose residual is lost if a driver lowers Fma to FMul then FAdd.
layout(local_size_x=8,local_size_y=1,local_size_z=1) in;
layout(binding=0) readonly buffer Input {float input_data[];};
layout(binding=1) writeonly buffer Output {float output_data[];};
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=8)return;
    precise float value=fma(input_data[i*3],input_data[i*3+1],input_data[i*3+2]);
    output_data[i]=value;
}
