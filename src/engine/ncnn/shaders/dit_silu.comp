#version 450
layout(local_size_x=128, local_size_y=1, local_size_z=1) in;
layout(binding=0) buffer Tensor { float data[]; };
// ncnn's SPIR-V reflection identifies this block by its lowercase name.
layout(push_constant) uniform parameter { int count, plane, cstep; } p;

// SLEEF 3.6.1 xexpf range reduction and polynomial, adapted for Vulkan FP32.
// Copyright Naoki Shibata and contributors 2010 - 2024.
// Distributed under the Boost Software License, Version 1.0.
// See third_party/engine/SLEEF-Boost-1.0.txt.
float exponential(float x) {
    float n = roundEven(x * 1.4426950408889634);
    float r = fma(-n, .693145751953125, x);
    r = fma(-n, 1.428606765330187e-6, r);
    float y = 0.000198527617612853646278381;
    y = fma(y, r, 0.00139304355252534151077271);
    y = fma(y, r, 0.00833336077630519866943359);
    y = fma(y, r, 0.0416664853692054748535156);
    y = fma(y, r, 0.166666671633720397949219);
    y = fma(y, r, .5);
    precise float squared = r*r;
    precise float reduced = 1. + fma(squared, y, r);
    return ldexp(reduced, int(n));
}
void main() {
    int logical = int(gl_GlobalInvocationID.y) * 65536 + int(gl_GlobalInvocationID.x);
    if (logical >= p.count) return;
    int i = (logical / p.plane) * p.cstep + logical % p.plane;
    float x = data[i];
    // For these tails, the locked FP32 expression rounds to x or signed zero.
    if (x >= 20.) { data[i] = x; return; }
    if (x <= -88.72283935546875) { data[i] = -0.; return; }
    precise float denominator = 1. + exponential(-x);
    precise float quotient = x / denominator;
    data[i] = fma(fma(-quotient, denominator, x), 1. / denominator, quotient);
}
